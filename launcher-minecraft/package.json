{
  "name": "launcher-minecraft",
  "version": "0.0.1-beta.2",
  "description": "Kurai Launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --windows"
  },
  "dependencies": {
    "minecraft-launcher-core": "^3.18.2",
    "xboxlive-auth": "^0.0.1-security"
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.suzukurai.kurailauncher",
    "productName": "KuraiLauncher",
    "win": {
      "target": [
        "portable"
      ],
      "icon": "icon.ico",
      "requestedExecutionLevel": "asInvoker" 
    },
    "portable": {
      "artifactName": "${productName}_Portable_${version}.${ext}",
      "splashImage": null
    },
    "files": [
      "**/*",
      "!dist/${/*}"
    ]
  }
}
