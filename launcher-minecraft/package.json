{
  "name": "kurai-launcher",
  "version": "0.0.1-beta.3",
  "description": "Kurai Launcher",
  "main": "main.js",
  "author": "SuzuKurai",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --windows"
  },
  "dependencies": {
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "xboxlive-auth": "^0.0.1-security"
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.suzukurai.kurailauncher",
    "productName": "KuraiLauncher",
    "win": {
      "target": [
        "nsis",
        "portable",
        "dir"
      ],
      "icon": "media/KuraiLauncher.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kurai Launcher"
    },
    "portable": {
      "artifactName": "${productName}_Portable_v${version}.${ext}",
      "splashImage": null
    },
    "files": [
      "**/*",
      "!dist/**/*"
    ]
  }
}
