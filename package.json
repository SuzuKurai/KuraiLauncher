{
  "name": "kurai-launcher",
  "version": "1.0.0",
  "description": "Kurai Launcher",
  "main": "main.js",
  "author": "SuzuKurai",
  "scripts": {
    "sync-version": "node sync-version.js",
    "prestart": "npm run sync-version",
    "predist": "npm run sync-version",
    "start": "electron .",
    "dist": "electron-builder --windows",
    "build": "electron-builder"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "discord-rpc-revamp": "^2.0.4",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "xboxlive-auth": "^0.0.1-security"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.suzukurai.kurailauncher",
    "productName": "KuraiLauncher",
    "win": {
      "target": [
        "nsis",
        "portable",
        "dir",
        "zip"
      ],
      "icon": "media/KuraiLauncher.ico",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "${productName}.v${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kurai Launcher",
      "artifactName": "${productName}.v${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}.Portable.v${version}.${ext}",
      "splashImage": null
    },
    "files": [
      "**/*",
      "!dist/**/*"
    ]
  }
}